<div class="ps-head"><div class="ps ps-narrow"><div class="ps-crumb"><a href="{{ routes.root_url }}">Home</a></div><h1>My account</h1></div></div>
<div class="ps">
  <div class="ps-acct">
    <div>
      <h3 style="margin-bottom:14px">Order history</h3>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="ct">
            <thead><tr><th>Order</th><th>Date</th><th>Payment</th><th>Fulfilment</th><th style="text-align:right">Total</th></tr></thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr><td><a class="lnk" href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: '%-d %b %Y' }}</td><td>{{ order.financial_status_label }}</td><td>{{ order.fulfillment_status_label }}</td><td class="tot">{{ order.total_price | money }}</td></tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}<p>You haven't placed any orders yet.</p>{%- endif -%}
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    </div>
    <div class="ps-box">
      <h3>Account details</h3>
      <p>{{ customer.name }}<br>{{ customer.email }}</p>
      {%- if customer.default_address -%}<p>{{ customer.default_address | format_address }}</p>{%- endif -%}
      <p><a class="lnk" href="{{ routes.account_addresses_url }}">Manage addresses ({{ customer.addresses_count }})</a></p>
      <p><a class="lnk" href="{{ routes.account_logout_url }}">Log out</a></p>
    </div>
  </div>
</div>
{% schema %}{"name":"Customer account","settings":[]}{% endschema %}
