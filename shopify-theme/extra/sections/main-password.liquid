<div class="ps ps-narrow" style="text-align:center;padding-top:clamp(60px,12vh,140px)">
  <h1 style="font-size:clamp(32px,5vw,56px);margin-bottom:14px">{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'ps-form', style: 'margin:30px auto 0;text-align:left' -%}
    {%- if form.errors -%}<div class="ps-err">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label for="pw">Store password</label><input type="password" id="pw" name="password" autocomplete="current-password">
    <button type="submit" class="btn p">Enter</button>
  {%- endform -%}
</div>
{% schema %}{"name":"Password","settings":[]}{% endschema %}
