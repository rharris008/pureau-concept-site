<div class="ps-head"><div class="ps ps-narrow"><div class="ps-crumb"><a href="{{ routes.root_url }}">Home</a></div><h1>Reset your password</h1></div></div>
<div class="ps ps-narrow">
  {%- form 'reset_customer_password', class: 'ps-form' -%}
    {%- if form.errors -%}<div class="ps-err">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label for="rp-pass">New password</label><input type="password" id="rp-pass" name="customer[password]" autocomplete="new-password">
    <label for="rp-pass2">Confirm password</label><input type="password" id="rp-pass2" name="customer[password_confirmation]" autocomplete="new-password">
    <button type="submit" class="btn p">Reset password</button>
  {%- endform -%}
</div>
{% schema %}{"name":"Reset password","settings":[]}{% endschema %}
